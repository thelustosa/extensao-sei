{
  "manifest_version": 3,
  "name": "SEI AGR - Link automatico",
  "version": "0.2.1",
  "description": "Detecta numeros de processo e documento no texto do editor do SEI e aplica o link SEI em lote, e importa a minuta gerada pelo Gestao de Autos IA para os blocos da Resolucao.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "cookies"],
  "host_permissions": [
    "https://gestao-autos.duckdns.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.go.gov.br/*controlador.php?acao=editor_montar*",
        "*://*.go.gov.br/*controlador.php?acao=texto_padrao_interno_alterar*",
        "*://*.go.gov.br/*controlador.php?acao=texto_padrao_interno_cadastrar*"
      ],
      "js": ["detectar.js", "blocos.js", "content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.go.gov.br/*controlador.php?acao=editor_montar*",
        "*://*.go.gov.br/*controlador.php?acao=texto_padrao_interno_alterar*",
        "*://*.go.gov.br/*controlador.php?acao=texto_padrao_interno_cadastrar*"
      ],
      "js": ["ponte.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gestao-autos.duckdns.org/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
